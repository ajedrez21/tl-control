{
  "timezone": "America/Argentina/Buenos_Aires",
  "agingUnit": "calendar-days",
  "azure": {
    "organization": "YOUR_ORG",
    "project": "YOUR_PROJECT",
    "process": "Agile",
    "apiVersion": "7.1",
    "areaPath": "",
    "iterationPath": "",
    "team": "",
