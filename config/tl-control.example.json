      "story": "User Story",
      "task": "Task",
      "bug": "Bug",
      "feature": "Feature"
    },
    "fieldMap": {
      "acceptanceCriteria": "Microsoft.VSTS.Common.AcceptanceCriteria",
      "priority": "Microsoft.VSTS.Common.Priority",
