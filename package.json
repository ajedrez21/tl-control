{
  "name": "tl-control",
  "version": "1.0.0",
  "description": "Sistema local de control técnico del Tech Lead: Azure, análisis, sprint, releases y dashboard HTML.",
  "type": "module",
  "bin": {
    "tl-control": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "test": "tsx --test --test-reporter=spec tests/acceptance.test.ts",
    "demo": "tsx src/cli/index.ts demo",
    "doctor": "tsx src/cli/index.ts doctor",
    "dashboard": "tsx src/cli/index.ts dashboard --demo"
  },
  "keywords": [
    "tech-lead",
    "azure-devops",
    "dashboard",
    "sprint"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/sanitize-html": "2.16.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
